<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contrato GADX + GeoAutoDocs.Inspection compartilhado pelo GeoAutoEngine e pelo GeoAutoDocs
       (DEC-ECO-0002, M3.3). Especificação: contratos/gadx-inspecao/SPEC.md.
       Só .NET 8: decisão do usuário em 16/11/2026 (apenas o Civil 3D 2026 é suportado). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RootNamespace>GeoEcosystem.Contracts.Inspection</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
