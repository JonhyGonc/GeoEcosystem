# Copie este arquivo para .env antes de iniciar o ambiente local.
# Estes valores são apenas exemplos locais. Não use em produção.
POSTGRES_DB=geomap
POSTGRES_USER=geomap
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8080
# Pasta das ortofotos (.mbtiles), fora do Git. Um arquivo por projeto: <nome do projeto>.mbtiles.
# Padrão: ./private-data/ortofotos. No Windows, pode ser outra pasta, por exemplo D:/Ortofotos.
GEOMAP_ORTHOPHOTO_DIR=./private-data/ortofotos
